<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  keychain-access-groups is REQUIRED, and removing it breaks Touch ID unlock.

	  It was briefly removed on the theory that a non-sandboxed app defaults to the
	  <TeamID>.<bundle id> group anyway. That is true of the FILE-BASED keychain, and
	  false of the one this app actually uses: KeychainManager stores the session key
	  with SecAccessControlCreateWithFlags(..., .userPresence, ...), and an
	  access-control-gated item lives in the DATA PROTECTION keychain, which on macOS
	  requires the app to carry this entitlement. Without it SecItemAdd fails with
	  errSecMissingEntitlement (-34018), surfaced in the UI as
	  "Keychain error: A required entitlement is not present."

	  This entitlement contains $(AppIdentifierPrefix), so it can only be authorised by
	  a provisioning profile. See build-support/Irys.provisionprofile and tools/release.sh.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.jng011.irys</string>
	</array>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
